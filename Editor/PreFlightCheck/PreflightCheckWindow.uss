/* Preflight Check window. Layers window-specific styles on top of the shared
   Divine Builder look (DivineWindow.uss), which is loaded alongside this sheet. */

.pf-root {
    flex-grow: 1;
}

.pf-toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 10px;
}

.pf-status {
    flex-shrink: 1;
    white-space: normal;
    margin-right: 8px;
    -unity-text-align: middle-left;
}

.pf-issues {
    flex-grow: 1;
}

.pf-empty {
    padding-top: 10px;
    padding-bottom: 10px;
    -unity-text-align: middle-center;
    white-space: normal;
    opacity: 0.6;
    -unity-font-style: italic;
}

.pf-group-desc {
    white-space: normal;
    font-size: 11px;
    opacity: 0.7;
    margin-bottom: 4px;
}

.pf-issue {
    flex-direction: row;
    align-items: flex-start;
    padding-top: 6px;
    padding-bottom: 6px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.15);
}

.pf-issue-icon {
    width: 16px;
    flex-shrink: 0;
    margin-right: 6px;
    margin-top: 1px;
    -unity-text-align: middle-center;
}

.pf-issue-body {
    flex-grow: 1;
    flex-shrink: 1;
}

.pf-issue-rule {
    font-size: 11px;
    -unity-font-style: bold;
    opacity: 0.85;
}

.pf-issue-path {
    font-size: 11px;
    opacity: 0.55;
    white-space: normal;
}

.pf-issue-msg {
    white-space: normal;
    margin-top: 2px;
}

.pf-issue-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 6px;
}

/* Per-issue jump links (specific material, renderer, …) under the message. */
.pf-issue-targets {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 2px;
}

.pf-issue-targets .pf-link {
    margin-right: 10px;
}

/* Filename rendered as a link that pings the asset. */
.pf-link {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: rgb(100, 149, 237);
    -unity-text-align: middle-left;
    align-self: flex-start;
}

.pf-link:hover {
    color: rgb(150, 190, 255);
}

/* Rules panel */
.pf-rules-scroll {
    max-height: 240px;
    flex-shrink: 0;
}

.pf-rule-pkg {
    -unity-font-style: bold;
    font-size: 11px;
    opacity: 0.8;
    margin-top: 6px;
    margin-bottom: 2px;
}

.pf-rule-row {
    flex-direction: row;
    align-items: center;
    padding-top: 4px;
    padding-bottom: 4px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.12);
}

.pf-rule-body {
    flex-grow: 1;
    flex-shrink: 1;
}

.pf-rule-name {
    -unity-font-style: bold;
}

.pf-rule-desc {
    white-space: normal;
    font-size: 11px;
    opacity: 0.7;
}

.pf-rule-meta {
    font-size: 11px;
    opacity: 0.55;
    margin-top: 1px;
}

.pf-rule-toggle {
    flex-shrink: 0;
    margin-left: 8px;
}
